APP_NAME=AI Study Companion
# Use "production" on Render (enforces a 32+ character JWT secret).
APP_ENV=development
DEBUG=true

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_study_companion

# Comma-separated browser origins allowed by CORS. Include your Vercel URL,
# e.g. https://your-app.vercel.app (no trailing slash).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Also allow Vercel preview deployments (*.vercel.app)?
CORS_ALLOW_VERCEL_PREVIEWS=false

# Groq (rotation/failover across keys)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_KEY_ATTEMPTS=6

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Embeddings run on fastembed (ONNX, no PyTorch).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_THREADS=1
EMBEDDING_BATCH_SIZE=8

# A material "processing" longer than this is shown as failed (with Retry).
MATERIAL_PROCESSING_TIMEOUT_MINUTES=10

UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

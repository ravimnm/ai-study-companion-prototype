{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"4OaTyVbJEFT-"},"outputs":[],"source":[["%pip install -q pymongo\n","\n","from pymongo import MongoClient\n","from pymongo.database import Database\n","\n","\n","COLLECTIONS = [\n","    \"users\",\n","    \"spaces\",\n","    \"projects\",\n","    \"materials\",\n","    \"document_chunks\",\n","    \"concepts\",\n","    \"conversations\",\n","    \"assessments\",\n","    \"mastery\",\n","    \"recommendations\",\n","    \"activities\",\n","    \"ai_usage\",\n","]\n","\n","\n","class MongoDB:\n","    \"\"\"MongoDB Atlas connection manager.\"\"\"\n","\n","    def __init__(\n","        self,\n","        uri: str,\n","        database_name: str,\n","    ):\n","        if not uri:\n","            raise ValueError(\"MONGODB_URI is required.\")\n","\n","        self.uri = uri\n","        self.database_name = database_name\n","        self.client: MongoClient | None = None\n","        self.db: Database | None = None\n","\n","    def connect(self) -> Database:\n","        \"\"\"Create the MongoDB connection and verify it.\"\"\"\n","\n","        self.client = MongoClient(\n","            self.uri,\n","            serverSelectionTimeoutMS=5000,\n","        )\n","\n","        self.client.admin.command(\"ping\")\n","\n","        self.db = self.client[self.database_name]\n","\n","        return self.db\n","\n","    def close(self) -> None:\n","        \"\"\"Close the MongoDB connection.\"\"\"\n","\n","        if self.client is not None:\n","            self.client.close()\n","\n","        self.client = None\n","        self.db = None\n","\n","    def collection(self, name: str):\n","        \"\"\"Return a MongoDB collection.\"\"\"\n","\n","        if self.db is None:\n","            raise RuntimeError(\n","                \"MongoDB is not connected.\"\n","            )\n","\n","        return self.db[name]\n","\n","    def initialize_collections(self) -> None:\n","        \"\"\"Create application collections if they do not exist.\"\"\"\n","\n","        if self.db is None:\n","            raise RuntimeError(\n","                \"MongoDB is not connected.\"\n","            )\n","\n","        existing = set(\n","            self.db.list_collection_names()\n","        )\n","\n","        for name in COLLECTIONS:\n","            if name not in existing:\n","                self.db.create_collection(name)\n","\n","        print(\"✓ Collections initialized\")\n","\n","    def initialize_indexes(self) -> None:\n","        \"\"\"Create standard MongoDB indexes.\"\"\"\n","\n","        if self.db is None:\n","            raise RuntimeError(\n","                \"MongoDB is not connected.\"\n","            )\n","\n","        self.collection(\"users\").create_index(\n","            \"email\",\n","            unique=True,\n","        )\n","\n","        self.collection(\"spaces\").create_index(\n","            \"user_id\"\n","        )\n","\n","        self.collection(\"projects\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"space_id\", 1),\n","            ]\n","        )\n","\n","        self.collection(\"materials\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","            ]\n","        )\n","\n","        self.collection(\"document_chunks\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","                (\"material_id\", 1),\n","            ]\n","        )\n","\n","        self.collection(\"conversations\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","            ]\n","        )\n","\n","        self.collection(\"assessments\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","            ]\n","        )\n","\n","        self.collection(\"mastery\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","                (\"concept_id\", 1),\n","            ],\n","            unique=True,\n","        )\n","\n","        self.collection(\"activities\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","                (\"created_at\", -1),\n","            ]\n","        )\n","\n","        self.collection(\"ai_usage\").create_index(\n","            [\n","                (\"user_id\", 1),\n","                (\"project_id\", 1),\n","                (\"created_at\", -1),\n","            ]\n","        )\n","\n","        print(\"✓ Standard indexes initialized\")\n","\n","    def initialize_vector_search_index(\n","        self,\n","        index_name: str = \"document_chunks_vector_index\",\n","    ) -> None:\n","        \"\"\"\n","        Create the MongoDB Atlas Vector Search index.\n","\n","        Local MiniLM embeddings use 384 dimensions.\n","        \"\"\"\n","\n","        if self.db is None:\n","            raise RuntimeError(\n","                \"MongoDB is not connected.\"\n","            )\n","\n","        collection = self.collection(\n","            \"document_chunks\"\n","        )\n","\n","        definition = {\n","            \"fields\": [\n","                {\n","                    \"type\": \"vector\",\n","                    \"path\": \"embedding\",\n","                    \"numDimensions\": 384,\n","                    \"similarity\": \"cosine\",\n","                },\n","                {\n","                    \"type\": \"filter\",\n","                    \"path\": \"user_id\",\n","                },\n","                {\n","                    \"type\": \"filter\",\n","                    \"path\": \"project_id\",\n","                },\n","                {\n","                    \"type\": \"filter\",\n","                    \"path\": \"material_id\",\n","                },\n","            ]\n","        }\n","\n","        try:\n","\n","            existing = list(\n","                collection.list_search_indexes()\n","            )\n","\n","            for index in existing:\n","\n","                if index.get(\"name\") == index_name:\n","\n","                    print(\n","                        f\"✓ Vector Search index already exists: \"\n","                        f\"{index_name}\"\n","                    )\n","\n","                    return\n","\n","            collection.create_search_index(\n","                {\n","                    \"name\": index_name,\n","                    \"definition\": definition,\n","                    \"type\": \"vectorSearch\",\n","                }\n","            )\n","\n","            print(\n","                f\"✓ Vector Search index creation requested: \"\n","                f\"{index_name}\"\n","            )\n","\n","        except Exception as exc:\n","\n","            raise RuntimeError(\n","                \"Unable to create MongoDB Atlas Vector Search \"\n","                f\"index '{index_name}'. Make sure the MongoDB \"\n","                \"deployment supports Atlas Vector Search and \"\n","                \"the database user has sufficient permissions.\"\n","            ) from exc\n","\n","    def vector_search_index_status(\n","        self,\n","        index_name: str = \"document_chunks_vector_index\",\n","    ) -> dict | None:\n","        \"\"\"Return the status of the Atlas Vector Search index.\"\"\"\n","\n","        if self.db is None:\n","            raise RuntimeError(\n","                \"MongoDB is not connected.\"\n","            )\n","\n","        collection = self.collection(\n","            \"document_chunks\"\n","        )\n","\n","        for index in collection.list_search_indexes():\n","\n","            if index.get(\"name\") == index_name:\n","\n","                return {\n","                    \"name\": index.get(\"name\"),\n","                    \"status\": index.get(\"status\"),\n","                    \"queryable\": index.get(\n","                        \"queryable\",\n","                        False,\n","                    ),\n","                }\n","\n","        return None\n","\n","\n","def create_database(\n","    mongodb_uri: str,\n","    database_name: str,\n",") -> MongoDB:\n","    \"\"\"Create and initialize the MongoDB manager.\"\"\"\n","\n","    database = MongoDB(\n","        uri=mongodb_uri,\n","        database_name=database_name,\n","    )\n","\n","    database.connect()\n","    database.initialize_collections()\n","    database.initialize_indexes()\n","\n","    return database"]],"id":"4OaTyVbJEFT-"},{"cell_type":"code","source":[[]],"metadata":{"id":"JCBPfneNEUjw"},"id":"JCBPfneNEUjw","execution_count":null,"outputs":[]}],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python"},"colab":{"provenance":[]}},"nbformat":4,"nbformat_minor":5}